# انسخ الملف ده لـ .env وغيّر القيم (الملف .env مش بيترفع على GitHub)
PORT=3000
DATA_DIR=./data
# إنشاء حسابات جديدة من /signup
ALLOW_SIGNUP=false
# أول حساب: /setup?token=<SETUP_TOKEN>  (فاضي = /setup مفتوح لأول زائر — مناسب على جهازك بس)
SETUP_TOKEN=
# ورا reverse proxy (Traefik / nginx)
TRUST_PROXY=false
COOKIE_SECURE=auto
# نسخ احتياطي على تيليجرام (اختياري)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_EVERY_DAYS=7
